diff --git a/internal/gateway/rests.go b/internal/gateway/rests.go
new file mode 100644
index 00000000..5b0b9825
--- /dev/null
+++ b/internal/gateway/rests.go
@@ -0,0 +1,165 @@
+package gateway
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+// restsFile is where the rests survive a restart.
+//
+// restingUntil is a map in memory: an account refused as out of quota rests
+// for as long as the vendor said, a key rate limited rests a minute, and
+// every one of those was lost the moment magpie stopped. The next start
+// knew nothing of them, so the first request after a restart asked the same
+// account that had just refused it, and was refused again — the account
+// rested for nothing, and the restart looked like it had reset its allowance
+// (which, for a vendor that counts by the hour, it had not).
+//
+// The file is beside providers.json, written when a rest is set or lifted
+// and read once at start. A rest that has already ended by then is dropped,
+// and one whose time is more than restMaxAhead away is taken as a clock that
+// moved, not a rest.
+const restsFile = "rests.json"
+
+// restMaxAhead is the longest a rest may still be in the future when read
+// back. A vendor's own reset time is the longest magpie keeps (a week's
+// window), so anything past this is a clock that went wrong, not a rest.
+const restMaxAhead = 30 * 24 * time.Hour
+
+// restsOnDisk is what the file holds: each rest by the key it rests by,
+// with the fields the picker and the next rest need.
+type restsOnDisk struct {
+	Rests map[string]Rest `json:"rests"`
+	// At is when this was written, for a clock that moved backwards.
+	At time.Time `json:"at"`
+}
+
+var (
+	restsMu   sync.Mutex
+	restsPath string
+	// restsSaveEvery is how long a change waits before it is written: rests
+	// are set in bursts (one refusal, then the next account's), and a write
+	// per refusal would be one file write per failed request.
+	restsSaveEvery = 500 * time.Millisecond
+	restsSaveTimer *time.Timer
+)
+
+// restsChanged asks for restingUntil to be written, at most once per
+// restsSaveEvery. The caller holds restingUntil's lock.
+func restsChanged() {
+	restsMu.Lock()
+	path := restsPath
+	restsMu.Unlock()
+	if path == "" {
+		return
+	}
+	restsMu.Lock()
+	if restsSaveTimer == nil {
+		restsSaveTimer = time.AfterFunc(restsSaveEvery, func() {
+			restsMu.Lock()
+			restsSaveTimer = nil
+			restsMu.Unlock()
+			restsSave()
+		})
+	}
+	restsMu.Unlock()
+}
+
+// restsFlush writes any pending change now, for a shutdown that would
+// otherwise lose the last rest of a run.
+func restsFlush() {
+	restsMu.Lock()
+	t := restsSaveTimer
+	restsSaveTimer = nil
+	restsMu.Unlock()
+	if t != nil {
+		t.Stop()
+	}
+	restsSave()
+}
+
+// restsWhere sets the file the rests are kept in, and reads what is there.
+// Called once, before the gateway serves anything.
+func restsWhere(dir string) {
+	restsMu.Lock()
+	restsPath = filepath.Join(dir, restsFile)
+	restsMu.Unlock()
+	restsLoad()
+}
+
+// restsLoad reads the file into restingUntil, dropping what has ended.
+func restsLoad() {
+	restsMu.Lock()
+	path := restsPath
+	restsMu.Unlock()
+	if path == "" {
+		return
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return
+	}
+	var d restsOnDisk
+	if json.Unmarshal(b, &d) != nil || len(d.Rests) == 0 {
+		return
+	}
+	now := time.Now()
+	restingUntil.Lock()
+	for key, r := range d.Rests {
+		// a rest that ended while magpie was down is no rest
+		if !r.Until.After(now) {
+			continue
+		}
+		// and one absurdly far off is a clock that moved, not a rest
+		if r.Until.Sub(now) > restMaxAhead {
+			continue
+		}
+		// what this computer found still stands: a file written elsewhere
+		// never shortens a rest this process already set
+		if was, ok := restingUntil.m[key]; ok && was.After(r.Until) {
+			continue
+		}
+		restingUntil.m[key] = r.Until
+		restingUntil.note[key] = r
+	}
+	restingUntil.Unlock()
+}
+
+// restsSave writes restingUntil to the file, dropping what has ended.
+// Called with restingUntil unlocked, after a change.
+func restsSave() {
+	restsMu.Lock()
+	path := restsPath
+	restsMu.Unlock()
+	if path == "" {
+		return
+	}
+	now := time.Now()
+	restingUntil.Lock()
+	out := restsOnDisk{Rests: make(map[string]Rest, len(restingUntil.m)), At: now}
+	for key, until := range restingUntil.m {
+		if !until.After(now) {
+			continue
+		}
+		out.Rests[key] = restingUntil.note[key]
+	}
+	restingUntil.Unlock()
+	b, err := json.Marshal(out)
+	if err != nil {
+		return
+	}
+	// a write that fails costs the next restart its rests, never this run's
+	if tmp, err := os.CreateTemp(filepath.Dir(path), restsFile+".*"); err == nil {
+		if _, err := tmp.Write(b); err == nil && tmp.Close() == nil {
+			if os.Rename(tmp.Name(), path) == nil {
+				return
+			}
+		}
+		tmp.Close()
+		os.Remove(tmp.Name())
+	}
+	os.WriteFile(path, b, 0o600)
+}
diff --git a/internal/gateway/rests_test.go b/internal/gateway/rests_test.go
new file mode 100644
index 00000000..e9e03871
--- /dev/null
+++ b/internal/gateway/rests_test.go
@@ -0,0 +1,158 @@
+package gateway
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+
+// restsReset clears the global map and points the file at dir, for a test
+// that starts as a fresh process would.
+func restsReset(t *testing.T, dir string) {
+	t.Helper()
+	restingUntil.Lock()
+	restingUntil.m = map[string]time.Time{}
+	restingUntil.note = map[string]Rest{}
+	restingUntil.lifted = map[string]time.Time{}
+	restingUntil.Unlock()
+	restsMu.Lock()
+	restsSaveTimer = nil
+	restsMu.Unlock()
+	restsWhere(dir)
+}
+
+// restAfterReset is what a test does to look like a new process.
+func restAfterReset(t *testing.T, dir string) {
+	t.Helper()
+	restingUntil.Lock()
+	restingUntil.m = map[string]time.Time{}
+	restingUntil.note = map[string]Rest{}
+	restingUntil.Unlock()
+	restsWhere(dir)
+}
+
+// restingUntil is a map in memory, so a restart used to forget every rest:
+// the first request after one asked the account that had just refused it.
+// These hold the file that carries them across.
+func TestRestsSurviveARestart(t *testing.T) {
+	dir := t.TempDir()
+	restsReset(t, dir)
+
+	// an account out of quota until an hour from now
+	until := time.Now().Add(time.Hour).Truncate(time.Second)
+	restingUntil.Lock()
+	restingUntil.m["zcode"] = until
+	restingUntil.note["zcode"] = Rest{Why: failQuota, Status: 429, By: "quota", Key: "zcode", Until: until}
+	restsChanged()
+	restingUntil.Unlock()
+
+	restsFlush()
+
+	// a new process: the map starts empty
+	restAfterReset(t, dir)
+
+	restingUntil.Lock()
+	got, ok := restingUntil.m["zcode"]
+	why := restingUntil.note["zcode"].Why
+	restingUntil.Unlock()
+	if !ok {
+		t.Fatal("the rest did not survive: zcode is not resting after a restart")
+	}
+	if !got.Equal(until) {
+		t.Fatalf("the rest ends at %v, want %v", got, until)
+	}
+	if why != failQuota {
+		t.Fatalf("the rest's why is %q, want %q", why, failQuota)
+	}
+}
+
+// A rest that ended while magpie was down is no rest: the account may be
+// asked at once.
+func TestAnEndedRestIsNotLoaded(t *testing.T) {
+	dir := t.TempDir()
+	restsReset(t, dir)
+
+	past := time.Now().Add(-time.Minute)
+	restingUntil.Lock()
+	restingUntil.m["old"] = past
+	restingUntil.note["old"] = Rest{Why: failQuota, Status: 429, By: "quota", Key: "old", Until: past}
+	restsChanged()
+	restingUntil.Unlock()
+	restsFlush()
+
+	restAfterReset(t, dir)
+
+	restingUntil.Lock()
+	_, ok := restingUntil.m["old"]
+	restingUntil.Unlock()
+	if ok {
+		t.Fatal("a rest that ended before the restart is still resting")
+	}
+}
+
+// A rest absurdly far in the future is a clock that moved, not a rest: the
+// account would be benched for years.
+func TestARestPastTheLongestWindowIsDropped(t *testing.T) {
+	dir := t.TempDir()
+	restsReset(t, dir)
+
+	far := time.Now().Add(restMaxAhead + time.Hour)
+	restingUntil.Lock()
+	restingUntil.m["clock"] = far
+	restingUntil.note["clock"] = Rest{Why: failQuota, Status: 429, By: "quota", Key: "clock", Until: far}
+	restsChanged()
+	restingUntil.Unlock()
+	restsFlush()
+
+	restAfterReset(t, dir)
+
+	restingUntil.Lock()
+	_, ok := restingUntil.m["clock"]
+	restingUntil.Unlock()
+	if ok {
+		t.Fatal("a rest 30 days out was loaded: a clock that moved benches an account for years")
+	}
+}
+
+// Lifting a rest writes that too, so a restart doesn't bring it back.
+func TestALiftedRestStaysLifted(t *testing.T) {
+	dir := t.TempDir()
+	restsReset(t, dir)
+
+	until := time.Now().Add(time.Hour)
+	restingUntil.Lock()
+	restingUntil.m["lift"] = until
+	restingUntil.note["lift"] = Rest{Why: failQuota, Status: 429, By: "quota", Key: "lift", Until: until}
+	restsChanged()
+	restingUntil.Unlock()
+	restsFlush()
+
+	(&Server{}).Unrest("lift")
+	restsFlush()
+
+	restAfterReset(t, dir)
+
+	restingUntil.Lock()
+	_, ok := restingUntil.m["lift"]
+	restingUntil.Unlock()
+	if ok {
+		t.Fatal("a lifted rest came back after a restart")
+	}
+}
+
+// No file, no rests: a first start must not fail.
+func TestRestsWithoutAFile(t *testing.T) {
+	dir := t.TempDir()
+	restsReset(t, dir)
+	restingUntil.Lock()
+	n := len(restingUntil.m)
+	restingUntil.Unlock()
+	if n != 0 {
+		t.Fatalf("a fresh folder left %d rests", n)
+	}
+	if _, err := os.Stat(filepath.Join(dir, restsFile)); err == nil {
+		t.Fatal("loading wrote a file; only a change should")
+	}
+}
